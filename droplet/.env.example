HUB_DOMAIN=hub.example.com
ACME_EMAIL=admin@example.com

# HAProxy backends connect to these loopback-only host ports.
EDGE_BIND_IP=127.0.0.1
EDGE_HTTP_PORT=19080
EDGE_HTTPS_PORT=19443

# Docker bridge gateway seen by Caddy for HAProxy-originated connections.
EDGE_PROXY_SOURCE_CIDR=172.31.0.1/32

# Public control endpoint for the outbound home tunnel.
TUNNEL_SSH_BIND=0.0.0.0
TUNNEL_SSH_PORT=22022
