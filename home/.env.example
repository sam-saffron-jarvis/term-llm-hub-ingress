HUB_DOMAIN=hub.example.com
ACME_EMAIL=admin@example.com

# Current public droplet address or stable SSH hostname.
DROPLET_HOST=203.0.113.10
TUNNEL_SSH_PORT=22022

# Numeric owner of secrets/tunnel_ed25519 and secrets/known_hosts. Usually the
# deployment account; check with: stat -c '%u:%g' secrets/tunnel_ed25519
AUTOSSH_UID=1000
AUTOSSH_GID=1000

# Address assigned to the homelab proxy host. Use 0.0.0.0 only when intended.
# This is ignored when compose.lan-ip.yaml is enabled.
LOCAL_BIND_IP=192.168.50.10

# Optional dedicated-LAN-IP mode for hosts where another proxy owns host ports
# 80 and 443. These values are used only with compose.lan-ip.yaml. The external
# Docker network must already exist and the address must be reserved for Caddy.
CADDY_LAN_NETWORK=homelab_lan
CADDY_LAN_IP=192.168.50.11

# Pin deliberately. TERM_LLM_SOURCE_COMMIT is normally empty, so the image uses
# the versioned release and verifies these two asset hashes. The updater's --main
# mode sets it to an exact commit and builds that source instead.
TERM_LLM_VERSION=v0.0.403
TERM_LLM_SOURCE_COMMIT=
TERM_LLM_SHA256_AMD64=91345a4b1d321fd0b363af73b5b6d441fbbfb3d9c2d357d66a73c61bb9517c23
TERM_LLM_SHA256_ARM64=cbefb51ee1218cf4c03b8b7ef39fee09e887364c2dcd259692363c4df1c0f01c
